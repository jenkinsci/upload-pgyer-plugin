<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:section title="${%PGYER}">
        <f:entry title="${%Default API key}" field="credentialsId">
            <c:select/>
        </f:entry>
        <f:advanced>
            <f:entry title="${%API server}" field="apiServer">
                <f:textbox/>
            </f:entry>
        </f:advanced>
    </f:section>
</j:jelly>
