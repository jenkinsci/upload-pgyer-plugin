<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="${%File}" field="file">
        <f:textbox/>
    </f:entry>
    <f:entry title="${%API key}" field="credentialsId">
        <c:select/>
    </f:entry>
    <f:advanced>
        <f:entry title="${%Build type}" field="buildType">
            <f:select/>
        </f:entry>
        <f:entry title="${%Install type}" field="installType">
            <f:select/>
        </f:entry>
        <f:entry title="${%Install password}" field="password">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%Description}" field="description">
            <f:textarea/>
        </f:entry>
        <f:entry title="${%Update description}" field="updateDescription">
            <f:textarea/>
        </f:entry>
        <f:entry title="${%Channel shortcut}" field="channelShortcut">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%Install start date}" field="installStartDate" help="/descriptor/io.jenkins.plugins.pgyer.PgyerUploadStep/help/installPeriod">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%Install end date}" field="installEndDate" help="/descriptor/io.jenkins.plugins.pgyer.PgyerUploadStep/help/installPeriod">
            <f:textbox/>
        </f:entry>
        <f:entry title="${%Processing timeout in seconds}" field="processingTimeout">
            <f:number/>
        </f:entry>
    </f:advanced>
</j:jelly>
