<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="API key" field="credentialsId" help="/plugin/upload-pgyer/help/credentialsId.html">
        <c:select/>
    </f:entry>
    <j:if test="${instance.apiKey != null}">
        <f:entry title="API key (deprecated)" field="apiKey" help="/plugin/upload-pgyer/help/apiKey.html">
            <f:password/>
        </f:entry>
    </j:if>
    <f:entry title="Directory" field="scanDir" help="/plugin/upload-pgyer/help/scanDir.html">
        <f:textbox default="$${WORKSPACE}"/>
    </f:entry>
    <f:entry title="File" field="wildcard" help="/plugin/upload-pgyer/help/wildcard.html">
        <f:textbox/>
    </f:entry>
    <f:entry title="Build type" field="buildType" help="/plugin/upload-pgyer/help/buildType.html">
        <f:select/>
    </f:entry>
    <f:advanced>
        <f:entry title="Install type" field="buildInstallType" help="/plugin/upload-pgyer/help/installType.html">
            <f:select/>
        </f:entry>
        <f:entry title="Install password" field="buildPassword">
            <f:password/>
        </f:entry>
        <f:entry title="Description" field="buildDescription" help="/plugin/upload-pgyer/help/description.html">
            <f:textarea/>
        </f:entry>
        <f:entry title="Update description" field="buildUpdateDescription" help="/plugin/upload-pgyer/help/updateDescription.html">
            <f:textarea/>
        </f:entry>
        <f:entry title="Channel shortcut" field="buildChannelShortcut" help="/plugin/upload-pgyer/help/channelShortcut.html">
            <f:textbox/>
        </f:entry>
        <f:entry title="Install start date" field="buildInstallStartDate" help="/plugin/upload-pgyer/help/installPeriod.html">
            <f:textbox/>
        </f:entry>
        <f:entry title="Install end date" field="buildInstallEndDate" help="/plugin/upload-pgyer/help/installPeriod.html">
            <f:textbox/>
        </f:entry>
    </f:advanced>
</j:jelly>
